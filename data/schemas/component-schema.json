{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"component-schema.json",
  "title":"Weapon Component Collection",
  "type":"object",
  "required":["schema_version","components"],
  "properties":{"schema_version":{"const":1},"components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}}},
  "$defs":{"component":{"type":"object","additionalProperties":false,"required":["id","display_name","slot","tags","modifiers"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9_]+$"},"display_name":{"type":"string","minLength":1},"slot":{"enum":["frame","action","payload","mutation","flaw"]},"tags":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"modifiers":{"type":"object","additionalProperties":{"type":"number"}},"cost":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"failure":{"enum":["jam","backfire","noise_spike"]}}}}
}
